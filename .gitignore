# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# OS and editors
.DS_Store
.idea/
.vscode/

# Soft-deleted files. `device_bash` cannot remove a file on a mounted folder, so things
# are moved here instead of deleted, and the folder is not part of the repository.
_trash/
_to_delete/

# Generated diagrams and renders. `docs/bpmnworkflow.png` is the exception and is
# committed: it is the picture the README points at, not a build product.
out/
*.pdf
*.svg
*.png
!docs/*.png

# A lock file belongs to an application, not to a library. This package is installed by
# other projects, which resolve their own dependencies; committing a lock here would
# claim a say over resolutions that are not ours to make.
uv.lock
